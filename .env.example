# ────────────────────────────────────────────────────────────────
# Base de données PostgreSQL (Neon) — OBLIGATOIRE
# Chaîne de connexion complète, récupérable dans le dashboard Neon
# ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ────────────────────────────────────────────────────────────────
# Administration
# Mot de passe admin par défaut (modifiable ensuite dans Dashboard > Paramètres)
# ────────────────────────────────────────────────────────────────
ADMIN_PASSWORD="admin123"

# ────────────────────────────────────────────────────────────────
# URL publique de la plateforme (optionnel)
# Utilisée pour les redirections de paiement returnUrl/cancelUrl.
# Sinon déduite automatiquement de la requête (host + proto).
# ────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"

# ────────────────────────────────────────────────────────────────
# Chatbot IA (optionnel — vide = service désactivé)
# ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=""

# ────────────────────────────────────────────────────────────────
# Passerelle de paiement Djomy — https://djomy.com (optionnel)
# Vide = paiements désactivés (les endpoints répondent 503).
# Récupérables dans votre espace marchand Djomy > Développeur.
# DJOMY_CLIENT_ID (public) + DJOMY_CLIENT_SECRET (confidentiel,
# utilisé pour la signature HMAC-SHA256 et la vérification des webhooks)
# ────────────────────────────────────────────────────────────────
DJOMY_API_URL="https://api.djomy.africa"
DJOMY_CLIENT_ID=""
DJOMY_CLIENT_SECRET=""
DJOMY_PARTNER_DOMAIN=""
